<Page
    x:Class="W10MSecurityCam.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <CaptureElement x:Name="PreviewElement" Stretch="Uniform" />
        <TextBlock x:Name="PreviewOffText" Text="Preview off" Foreground="#888"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

        <ScrollViewer Grid.Column="1" Background="#1A1A1A" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,6,10,10">
                <TextBlock x:Name="TitleText" Text="W10MSecurityCam" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6" />

                <!-- STATUS -->
                <TextBlock Text="STATUS" Foreground="#8AB" FontSize="12" FontWeight="SemiBold" />
                <Button x:Name="StartButton" Content="Start streaming" HorizontalAlignment="Stretch"
                        Margin="0,4,0,6" Click="StartButton_Click" IsEnabled="False" />
                <TextBlock x:Name="StatsText" Text="Idle" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="LightGray" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="RTSP address (NVR / VLC):" Foreground="#AAA" FontSize="12" />
                <TextBlock x:Name="AddressText" Text="…" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />

                <!-- VIDEO -->
                <TextBlock Text="VIDEO" Foreground="#8AB" FontSize="12" FontWeight="SemiBold" />
                <ComboBox x:Name="ResolutionBox" Header="Resolution" SelectionChanged="Setting_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                <ComboBox x:Name="BitrateBox" Header="Bitrate" SelectionChanged="Setting_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                <ToggleSwitch x:Name="HighBwToggle" Header="High bandwidth mode: unlocks bitrates above 24 Mbps (needs 5 GHz Wi-Fi or USB-C; on 2.4 GHz it drops frames)" IsOn="False" Toggled="HighBwToggle_Toggled" />
                <ComboBox x:Name="KeyframeBox" Header="Keyframe every" SelectionChanged="Setting_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                <ToggleSwitch x:Name="AudioToggle" Header="Microphone audio in the stream (AAC)" IsOn="False" Toggled="AudioToggle_Toggled" />
                <ToggleSwitch x:Name="UdpToggle" Header="Allow RTP over UDP (TCP is more reliable on Wi-Fi)" IsOn="False" Toggled="UdpToggle_Toggled" />
                <ToggleSwitch x:Name="SnapshotToggle" Header="Snapshots at /snapshot.jpg (photo while recording)" IsOn="False" Toggled="SnapshotToggle_Toggled" />
                <ToggleSwitch x:Name="AutoStartToggle" Header="Start streaming when app opens" IsOn="True" Toggled="AutoStartToggle_Toggled" />

                <!-- CAMERA -->
                <TextBlock Text="CAMERA" Foreground="#8AB" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" />
                <CheckBox x:Name="AutoCameraCheck" Content="Automatic focus, exposure and white balance" IsChecked="True"
                          Checked="AutoCameraCheck_Changed" Unchecked="AutoCameraCheck_Changed" />
                <Button x:Name="FocusOnceButton" Content="Focus once and lock" Click="FocusOnceButton_Click" HorizontalAlignment="Stretch" Margin="0,2,0,4" />
                <TextBlock x:Name="TuningStateText" Text="" FontSize="11" Foreground="#CCC" TextWrapping="Wrap" Margin="0,0,0,4" />
                <!-- Shown while at least one setting is manual. Each row: label + its own Auto box, then the slider
                     (greyed out while that setting is automatic). All three on Auto hides this panel again. -->
                <StackPanel x:Name="ManualCameraPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="FocusLabel" Text="Focus" FontSize="12" VerticalAlignment="Center" />
                        <CheckBox x:Name="FocusAutoCheck" Grid.Column="1" Content="Auto" MinWidth="0" FontSize="12"
                                  Checked="SubAuto_Changed" Unchecked="SubAuto_Changed" />
                    </Grid>
                    <Slider x:Name="FocusSlider" Minimum="0" Maximum="100" StepFrequency="1" Margin="0,-6,0,0" ValueChanged="TuningSlider_ValueChanged" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ExposureLabel" Text="Exposure" FontSize="12" VerticalAlignment="Center" />
                        <CheckBox x:Name="ExposureAutoCheck" Grid.Column="1" Content="Auto" MinWidth="0" FontSize="12"
                                  Checked="SubAuto_Changed" Unchecked="SubAuto_Changed" />
                    </Grid>
                    <Slider x:Name="ExposureSlider" Minimum="0" Maximum="100" StepFrequency="0.5" Margin="0,-6,0,0" ValueChanged="TuningSlider_ValueChanged" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="WbLabel" Text="White balance" FontSize="12" VerticalAlignment="Center" />
                        <CheckBox x:Name="WbAutoCheck" Grid.Column="1" Content="Auto" MinWidth="0" FontSize="12"
                                  Checked="SubAuto_Changed" Unchecked="SubAuto_Changed" />
                    </Grid>
                    <Slider x:Name="WbSlider" Minimum="2000" Maximum="8000" StepFrequency="100" Margin="0,-6,0,0" ValueChanged="TuningSlider_ValueChanged" />
                </StackPanel>


                <!-- POWER -->
                <TextBlock Text="POWER" Foreground="#8AB" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" />
                <Button x:Name="PowerSaveButton" Content="Save power now: black out the screen" HorizontalAlignment="Stretch"
                        Margin="0,4,0,4" Click="PowerSaveButton_Click" />
                <TextBlock Text="Brightness to zero, black screen, preview off. Tap the screen to look for 15 s." Foreground="#999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                <ToggleSwitch x:Name="PowerSaveToggle" Header="Blackout screen while streaming (paused while adjusting the camera)" IsOn="True" Toggled="PowerSaveToggle_Toggled" />
                <ToggleSwitch x:Name="PreviewToggle" Header="Preview on phone (always on while adjusting the camera)" IsOn="True" Toggled="PreviewToggle_Toggled" />

                <!-- LOGIN + LOG -->
                <TextBlock Text="Login (stream and web page)" Foreground="#AAA" FontSize="12" Margin="0,8,0,0" />
                <TextBlock x:Name="LoginStatusText" Text="" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBox x:Name="UserBox" PlaceholderText="User name (admin)" Margin="0,0,0,4" />
                <PasswordBox x:Name="PassBox" PlaceholderText="New password (empty = reset to admin)" Margin="0,0,0,4" />
                <Button x:Name="SaveLoginButton" Content="Save login" HorizontalAlignment="Stretch" Click="SaveLoginButton_Click" Margin="0,0,0,6" />

                <TextBlock Text="Log" Foreground="#AAA" FontSize="12" Margin="0,6,0,0" />
                <TextBlock x:Name="LogText" FontSize="11" TextWrapping="Wrap" Foreground="#CCC"
                           IsTextSelectionEnabled="True" FontFamily="Consolas" />
            </StackPanel>
        </ScrollViewer>

        <!-- Full black overlay: on an OLED screen black pixels are off, so this costs almost no power and avoids burn-in. -->
        <Border x:Name="BlackoutOverlay" Grid.ColumnSpan="2" Background="Black" Visibility="Collapsed" Tapped="BlackoutOverlay_Tapped">
            <TextBlock Text="Streaming - tap to show controls" Foreground="#222" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
        </Border>
    </Grid>
</Page>
