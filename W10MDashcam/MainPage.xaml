<Page
    x:Class="W10MDashcam.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">
    <Page.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#0B1A10" />
            <Setter Property="BorderBrush" Value="#16301E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,3,5,4" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="Foreground" Value="#6F8F77" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#D6E8D9" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Storyboard x:Name="DotPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1" />
        </Storyboard>
        <Style x:Key="FoldButton" TargetType="Button">
            <Setter Property="Background" Value="#0B1A10" />
            <Setter Property="BorderThickness" Value="3,0,0,1" />
            <Setter Property="BorderBrush" Value="#3FBF5F" />
            <Setter Property="Foreground" Value="#9CF0B0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,9,10,9" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <!-- Plain action buttons: dark green with a soft green edge. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#123320" />
            <Setter Property="Foreground" Value="#CFFFD8" />
            <Setter Property="BorderBrush" Value="#2E7D46" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <CaptureElement x:Name="PreviewElement" Stretch="Uniform" />
        <TextBlock x:Name="PreviewOffText" Text="Preview off" Foreground="#888"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

        <ScrollViewer Grid.Column="1" Background="#050805" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,6,10,10">
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="TitleText" Text="W10MDashcam" FontSize="20" FontWeight="SemiBold" Foreground="#E4F5E7" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="VersionText" Text="" FontSize="11" FontWeight="Bold" Foreground="#39FF14" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>

                <!-- MAIN: what is needed day to day. Everything else folds away below. -->
                <!-- Recording and live view are separate: the camera runs while either one is on. -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RecordButton" Content="Start recording" HorizontalAlignment="Stretch" FontSize="13"
                            Click="RecordButton_Click" IsEnabled="False" />
                    <Button x:Name="StartButton" Grid.Column="2" Content="Start streaming" HorizontalAlignment="Stretch" FontSize="13"
                            Click="LiveButton_Click" IsEnabled="False" />
                </Grid>
                <!-- Dashcam recording card: REC state, the Save clip button, storage summary. -->
                <Border Background="#140707" BorderBrush="#3A1F1F" BorderThickness="1" CornerRadius="6" Padding="10,8,10,8" Margin="0,0,0,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="#555555" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="RecStateText" Text="OFF" FontSize="13" FontWeight="SemiBold" Foreground="#F0B0B0" CharacterSpacing="60" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="SaveClipButton" Content="SAVE CLIP" HorizontalAlignment="Stretch" FontWeight="Bold" Margin="0,6,0,4"
                                Background="#5A1010" Foreground="#FFE0E0" BorderBrush="#A03030" Click="SaveClipButton_Click" IsEnabled="False" />
                        <TextBlock x:Name="RecInfoText" Text="" FontSize="11" Foreground="#C9B0B0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <!-- Status card: state dot and label, resolution and viewer pills, then the big numbers. -->
                <Border Background="#07140B" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="6" Padding="10,8,10,8" Margin="0,0,0,6">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#555555" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock x:Name="StateText" Text="STOPPED" FontSize="13" FontWeight="SemiBold" Foreground="#9CF0B0" CharacterSpacing="60" VerticalAlignment="Center" />
                                <Border x:Name="ResPill" BorderBrush="#2E7D46" BorderThickness="1" CornerRadius="9" Background="#0B1A10" Padding="6,0,6,1" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="ResText" FontSize="11" Foreground="#9CF0B0" />
                                </Border>
                            </StackPanel>
                            <Border BorderBrush="#2E7D46" BorderThickness="1" CornerRadius="9" Background="#0B1A10" Padding="6,0,6,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="ViewersText" Text="0 viewers" FontSize="11" Foreground="#9CF0B0" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="StatsText" Text="" FontFamily="Consolas" FontSize="20" Foreground="#E4F5E7" Margin="0,6,0,0" Visibility="Collapsed" />
                        <Grid Margin="-2,6,-2,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="BATTERY" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="BattText" Text="-" Style="{StaticResource TileValue}" />
                                    <Grid x:Name="BattBar" Height="6" Margin="0,3,0,0" Background="#06100A" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0*" /><ColumnDefinition Width="100*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="BattBarFill" Background="#39FF14" CornerRadius="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="WI-FI" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="WifiText" Text="-" Style="{StaticResource TileValue}" />
                                    <StackPanel Orientation="Horizontal" Height="12" Margin="0,3,0,0">
                                        <Rectangle x:Name="Wifi1" Width="5" Height="3" Margin="0,0,2,0" VerticalAlignment="Bottom" Fill="#16301E" />
                                        <Rectangle x:Name="Wifi2" Width="5" Height="6" Margin="0,0,2,0" VerticalAlignment="Bottom" Fill="#16301E" />
                                        <Rectangle x:Name="Wifi3" Width="5" Height="9" Margin="0,0,2,0" VerticalAlignment="Bottom" Fill="#16301E" />
                                        <Rectangle x:Name="Wifi4" Width="5" Height="12" VerticalAlignment="Bottom" Fill="#16301E" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="TEMP" Style="{StaticResource TileLabel}" />
                                    <Border x:Name="TempBadge" CornerRadius="9" BorderThickness="1" Padding="5,1,6,1" Margin="0,3,0,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="TempBadgeDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock x:Name="TempBadgeText" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="CPU PHONE" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="CpuPhoneText" Text="-" Style="{StaticResource TileValue}" />
                                    <Grid x:Name="CpuPhoneBar" Height="6" Margin="0,3,0,0" Background="#06100A" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0*" /><ColumnDefinition Width="100*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="CpuPhoneBarFill" Background="#39FF14" CornerRadius="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="CPU APP" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="CpuAppText" Text="-" Style="{StaticResource TileValue}" />
                                    <Grid x:Name="CpuAppBar" Height="6" Margin="0,3,0,0" Background="#06100A" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0*" /><ColumnDefinition Width="100*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="CpuAppBarFill" Background="#39FF14" CornerRadius="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="MEMORY" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="MemText" Text="-" Style="{StaticResource TileValue}" />
                                    <Grid x:Name="MemBar" Height="6" Margin="0,3,0,0" Background="#06100A" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0*" /><ColumnDefinition Width="100*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="MemBarFill" Background="#39FF14" CornerRadius="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="ENGINE" Style="{StaticResource TileLabel}" />
                                    <Border x:Name="EngBadge" CornerRadius="9" BorderThickness="1" Padding="5,1,6,1" Margin="0,3,0,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="EngBadgeDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock x:Name="EngBadgeText" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="LATENCY" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="LatText" Text="-" Style="{StaticResource TileValue}" />
                                    <Grid x:Name="LatBar" Height="6" Margin="0,3,0,0" Background="#06100A" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0*" /><ColumnDefinition Width="100*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="LatBarFill" Background="#39FF14" CornerRadius="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock x:Name="PowerLabel" Text="POWER" Style="{StaticResource TileLabel}" />
                                    <TextBlock x:Name="PowerValText" Text="-" Style="{StaticResource TileValue}" />
                                    <Grid x:Name="PowerBar" Height="6" Margin="0,3,0,0" Background="#06100A" BorderBrush="#1F3A26" BorderThickness="1" CornerRadius="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0*" /><ColumnDefinition Width="100*" /></Grid.ColumnDefinitions>
                                        <Border x:Name="PowerBarFill" Background="#39FF14" CornerRadius="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <!-- Notices: same look as the web page. -->
                        <Border x:Name="LoginNotice" Visibility="Collapsed" BorderBrush="#7D6E2E" BorderThickness="3,1,1,1" CornerRadius="5" Background="#1A1808" Padding="8,5,8,5" Margin="0,8,0,0">
                            <TextBlock Text="Default login admin / admin in use. Change it under Network and login." FontSize="11" Foreground="#E8D8A0" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="AlertText" Text="" Foreground="#FF5555" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4" />
                <Button x:Name="ShowPictureButton" Content="Show camera picture (60 s)" HorizontalAlignment="Stretch"
                        Margin="0,2,0,4" Click="ShowPictureButton_Click" />
                <Button x:Name="PowerSaveButton" Content="Black out the screen now" HorizontalAlignment="Stretch"
                        Margin="0,0,0,6" Click="PowerSaveButton_Click" />

                <Button Style="{StaticResource FoldButton}" Tag="RecordingPanel|RECORDING" Content="RECORDING  &#x25B8;" Click="Fold_Click" />
                <StackPanel x:Name="RecordingPanel" Visibility="Collapsed">
                    <ToggleSwitch x:Name="RecordOnOpenToggle" Header="Record when the app opens" IsOn="True" Toggled="RecordOnOpenToggle_Toggled" />
                    <ComboBox x:Name="LocationBox" Header="Save recordings to" SelectionChanged="LocationBox_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                    <Button x:Name="ChooseFolderButton" Content="Choose folder..." HorizontalAlignment="Stretch" Click="ChooseFolderButton_Click" Margin="0,0,0,2" />
                    <TextBlock x:Name="LocationText" Text="" FontSize="11" Foreground="#B9CFBD" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ComboBox x:Name="SegmentBox" Header="New file every" SelectionChanged="RecSetting_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <ComboBox x:Name="LimitBox" Header="Space for loop recording" SelectionChanged="RecSetting_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <ComboBox x:Name="ImpactBox" Header="Crash detection (saves a clip on impact)" SelectionChanged="ImpactBox_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,2" />
                    <TextBlock x:Name="ImpactText" Text="" FontSize="11" Foreground="#B9CFBD" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ToggleSwitch x:Name="KeepNextToggle" Header="Save clip also keeps the next file" IsOn="True" Toggled="KeepNextToggle_Toggled" />
                    <ComboBox x:Name="SavedLimitBox" Header="Space for saved clips" SelectionChanged="SavedLimitBox_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,2" />
                    <ToggleSwitch x:Name="ReplaceSavedToggle" Header="Replace the oldest saved clips when full" IsOn="False" Toggled="ReplaceSavedToggle_Toggled" />
                    <ToggleSwitch x:Name="GpsToggle" Header="GPS speed and position" IsOn="True" Toggled="GpsToggle_Toggled" />
                    <TextBlock x:Name="GpsText" Text="" FontSize="11" Foreground="#B9CFBD" TextWrapping="Wrap" Margin="0,-4,0,4" />
                    <ComboBox x:Name="UnitsBox" Header="Speed in" SelectionChanged="UnitsBox_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,2" />
                    <ToggleSwitch x:Name="SubtitlesToggle" Header="Date, time, speed and position in recordings (subtitles)" IsOn="True" Toggled="SubtitlesToggle_Toggled" />
                    <TextBlock Text="The oldest files are deleted to stay within this space. Saved clips (the current and the previous file) are never deleted, and files the app did not record are never touched. The camera button saves a clip too. Recordings: on the web page at /camera." FontSize="11" Foreground="#7F9A86" TextWrapping="Wrap" Margin="0,0,0,6" />
                </StackPanel>

                <Button Style="{StaticResource FoldButton}" Tag="VideoPanel|VIDEO" Content="VIDEO  &#x25B8;" Click="Fold_Click" />
                <StackPanel x:Name="VideoPanel" Visibility="Collapsed">
                    <TextBlock x:Name="VideoAlert" Text="THERMAL RECOVERY MODE: VIDEO LOWERED TO 1080P / 6 MBPS UNTIL CHARGING RESUMES" Foreground="#FF5555" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,2" />
                    <ComboBox x:Name="ResolutionBox" Header="Resolution" SelectionChanged="Setting_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <ComboBox x:Name="BitrateBox" Header="Bitrate" SelectionChanged="Setting_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <ToggleSwitch x:Name="HighBwToggle" Header="High bandwidth (over 24 Mbps)" IsOn="False" Toggled="HighBwToggle_Toggled" />
                    <TextBlock Text="Needs 5 GHz Wi-Fi or USB-C; drops frames on 2.4 GHz." Foreground="#7F9A86" FontSize="12" TextWrapping="Wrap" Margin="0,-4,0,6" />
                    <ComboBox x:Name="KeyframeBox" Header="Keyframe every" SelectionChanged="Setting_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <ToggleSwitch x:Name="AudioToggle" Header="Microphone audio (AAC)" IsOn="False" Toggled="AudioToggle_Toggled" />
                </StackPanel>

                <Button Style="{StaticResource FoldButton}" Tag="CameraPanel|CAMERA" Content="CAMERA  &#x25B8;" Click="Fold_Click" />
                <StackPanel x:Name="CameraPanel" Visibility="Collapsed">
                    <CheckBox x:Name="AutoCameraCheck" Content="Automatic focus, exposure and white balance" IsChecked="True"
                              Checked="AutoCameraCheck_Changed" Unchecked="AutoCameraCheck_Changed" />
                    <Button x:Name="FocusOnceButton" Content="Focus once and lock" Click="FocusOnceButton_Click" HorizontalAlignment="Stretch" Margin="0,2,0,4" />
                    <TextBlock x:Name="TuningStateText" Text="" FontSize="11" Foreground="#B9CFBD" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <!-- Shown while at least one setting is manual. Each row: label + its own Auto box, then the slider
                         (greyed out while that setting is automatic). All three on Auto hides this panel again. -->
                    <StackPanel x:Name="ManualCameraPanel" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="FocusLabel" Text="Focus" FontSize="12" VerticalAlignment="Center" />
                            <CheckBox x:Name="FocusAutoCheck" Grid.Column="1" Content="Auto" MinWidth="0" FontSize="12"
                                      Checked="SubAuto_Changed" Unchecked="SubAuto_Changed" />
                        </Grid>
                        <Slider x:Name="FocusSlider" Minimum="0" Maximum="100" StepFrequency="1" Margin="0,-6,0,0" ValueChanged="TuningSlider_ValueChanged" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExposureLabel" Text="Exposure" FontSize="12" VerticalAlignment="Center" />
                            <CheckBox x:Name="ExposureAutoCheck" Grid.Column="1" Content="Auto" MinWidth="0" FontSize="12"
                                      Checked="SubAuto_Changed" Unchecked="SubAuto_Changed" />
                        </Grid>
                        <Slider x:Name="ExposureSlider" Minimum="0" Maximum="100" StepFrequency="0.5" Margin="0,-6,0,0" ValueChanged="TuningSlider_ValueChanged" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="WbLabel" Text="White balance" FontSize="12" VerticalAlignment="Center" />
                            <CheckBox x:Name="WbAutoCheck" Grid.Column="1" Content="Auto" MinWidth="0" FontSize="12"
                                      Checked="SubAuto_Changed" Unchecked="SubAuto_Changed" />
                        </Grid>
                        <Slider x:Name="WbSlider" Minimum="2000" Maximum="8000" StepFrequency="100" Margin="0,-6,0,0" ValueChanged="TuningSlider_ValueChanged" />
                    </StackPanel>
                    <TextBlock x:Name="TorchAlert" Text="THERMAL RECOVERY MODE: FLASHLIGHT UNAVAILABLE UNTIL CHARGING RESUMES" Foreground="#FF5555" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,2" />
                    <ToggleSwitch x:Name="TorchToggle" Header="Flashlight" IsOn="False" Toggled="TorchToggle_Toggled" />
                    <TextBlock x:Name="TorchNote" Text="" Foreground="#7F9A86" FontSize="12" TextWrapping="Wrap" Margin="0,-4,0,4" />
                </StackPanel>

                <Button Style="{StaticResource FoldButton}" Tag="PowerPanel|POWER" Content="POWER  &#x25B8;" Click="Fold_Click" />
                <StackPanel x:Name="PowerPanel" Visibility="Collapsed">
                    <TextBlock x:Name="PowerAlert" Text="THERMAL RECOVERY MODE: POWER SAVING IS FORCED ON UNTIL CHARGING RESUMES" Foreground="#FF5555" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,2" />
                    <ToggleSwitch x:Name="PowerSaveToggle" Header="Black screen while streaming" IsOn="True" Toggled="PowerSaveToggle_Toggled" />
                    <TextBlock Text="Tap the black screen to read the status for 15 s. Show camera picture lights it for 60 s (the stream restarts briefly to start and stop the picture). The start/stop chirp follows the phone's Ringer + notifications volume." Foreground="#7F9A86" FontSize="12" TextWrapping="Wrap" Margin="0,-4,0,6" />
                    <CheckBox x:Name="SaveAllCheck" Content="Power-saving camera features" IsChecked="True"
                              Checked="SaveAll_Changed" Unchecked="SaveAll_Changed" />
                    <TextBlock Text="Less processing and heat. Untick to choose each one." Foreground="#7F9A86" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2" />
                    <StackPanel x:Name="SavePanel" Visibility="Collapsed" Margin="14,0,0,4">
                        <CheckBox x:Name="SaveOisCheck" Content="Stabilization off (fixed mount)" FontSize="12" Checked="SaveSub_Changed" Unchecked="SaveSub_Changed" />
                        <CheckBox x:Name="SaveFocusCheck" Content="Hold focus once it has settled" FontSize="12" Checked="SaveSub_Changed" Unchecked="SaveSub_Changed" />
                    </StackPanel>
                </StackPanel>

                <Button Style="{StaticResource FoldButton}" Tag="NetworkPanel|NETWORK AND LOGIN" Content="NETWORK AND LOGIN  &#x25B8;" Click="Fold_Click" />
                <StackPanel x:Name="NetworkPanel" Visibility="Collapsed">
                    <TextBlock Text="RTSP address (NVR / VLC):" Foreground="#7F9A86" FontSize="12" />
                    <TextBlock x:Name="AddressText" Text="…" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ToggleSwitch x:Name="AutoStartToggle" Header="Live stream when the app opens" IsOn="True" Toggled="AutoStartToggle_Toggled" />
                    <ToggleSwitch x:Name="UdpToggle" Header="Allow RTP over UDP" IsOn="False" Toggled="UdpToggle_Toggled" />
                    <TextBlock Text="TCP is more reliable on Wi-Fi." Foreground="#7F9A86" FontSize="12" TextWrapping="Wrap" Margin="0,-4,0,6" />
                    <ToggleSwitch x:Name="SnapshotToggle" Header="Snapshots at /snapshot.jpg" IsOn="False" Toggled="SnapshotToggle_Toggled" />
                    <TextBlock Text="Login (stream and web page)" Foreground="#7F9A86" FontSize="12" Margin="0,8,0,0" />
                    <TextBlock x:Name="LoginStatusText" Text="" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBox x:Name="UserBox" PlaceholderText="User name (admin)" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PassBox" PlaceholderText="New password (empty = reset to admin)" Margin="0,0,0,4" />
                    <Button x:Name="SaveLoginButton" Content="Save login" HorizontalAlignment="Stretch" Click="SaveLoginButton_Click" Margin="0,0,0,6" />
                </StackPanel>

                <Button Style="{StaticResource FoldButton}" Tag="DetailsPanel|DETAILS AND LOG" Content="DETAILS AND LOG  &#x25B8;" Click="Fold_Click" />
                <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="LightGray" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock x:Name="LogText" FontSize="11" TextWrapping="Wrap" Foreground="#B9CFBD"
                               IsTextSelectionEnabled="True" FontFamily="Consolas" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Full black overlay: on an OLED screen black pixels are off, so this costs almost no power and avoids burn-in. -->
        <Border x:Name="BlackoutOverlay" Grid.ColumnSpan="2" Background="Black" Visibility="Collapsed" Tapped="BlackoutOverlay_Tapped">
            <TextBlock Text="Tap to show controls" Foreground="#222" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
        </Border>
    </Grid>
</Page>
