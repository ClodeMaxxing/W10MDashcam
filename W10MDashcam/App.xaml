<Application
    x:Class="W10MDashcam.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <!-- Green accent for switches, check boxes, sliders and focus outlines. -->
        <Color x:Key="SystemAccentColor">#FF2FA84F</Color>
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF2FA84F" />
        <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#FF3FBF5F" />
        <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#FF2FA84F" />
        <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="#FF3FBF5F" />
    </Application.Resources>
</Application>
